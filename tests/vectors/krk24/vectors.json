{
  "_about": "Hand-written vectors for conformance/terms.py (KRK-24, X2 design section 2.4; KRK-M152). Every expected answer was written from the design's table, not read off the code. fill: null means an exact fill; otherwise the reason. Item ids are bare strings here; the test turns them into {id, quantity}.",
  "fill": [
    {"name": "exact, one slot", "items": [["a1", 2]], "slots": [["s1", ["a1", "a2"], 2]], "expected": null},
    {"name": "exact, two slots", "items": [["a1", 1], ["b2", 3]], "slots": [["s1", ["a1"], 1], ["s2", ["b1", "b2"], 3]], "expected": null},
    {"name": "exact only by the right assignment (a greedy reader puts x in s1)", "items": [["x", 1], ["y", 1]], "slots": [["s1", ["x", "y"], 1], ["s2", ["x"], 1]], "expected": null},
    {"name": "two units of one item across two slots", "items": [["x", 2]], "slots": [["s1", ["x"], 1], ["s2", ["x"], 1]], "expected": null},
    {"name": "partial: a slot left empty", "items": [["a1", 1]], "slots": [["s1", ["a1"], 1], ["s2", ["b1"], 1]], "expected": "less"},
    {"name": "under_quantity", "items": [["a1", 1]], "slots": [["s1", ["a1"], 2]], "expected": "less"},
    {"name": "extra_item: every slot filled and one more", "items": [["a1", 1], ["z", 1]], "slots": [["s1", ["a1"], 1]], "expected": "more"},
    {"name": "over_quantity", "items": [["a1", 3]], "slots": [["s1", ["a1"], 2]], "expected": "more"},
    {"name": "not_acceptable: s1 filled from s2's list, counts unchanged", "items": [["b1", 2]], "slots": [["s1", ["a1"], 1], ["s2", ["b1"], 1]], "expected": "other"},
    {"name": "item_reused: one unit cannot count for two slots", "items": [["x", 1]], "slots": [["s1", ["x", "a1"], 1], ["s2", ["x", "b1"], 1]], "expected": "less"},
    {"name": "empty_slot: an empty list admits no item", "items": [["a1", 1], ["z", 1]], "slots": [["s1", ["a1"], 1], ["e", [], 1]], "expected": "other"},
    {"name": "no slots, no items", "items": [], "slots": [], "expected": null},
    {"name": "no slots, one item", "items": [["z", 1]], "slots": [], "expected": "more"}
  ],
  "fill_unreadable": [
    {"name": "quantity zero", "items": [{"id": "a1", "quantity": 0}]},
